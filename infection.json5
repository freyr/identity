{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "tmpDir": "cache/infection",
    "logs": {
        "text": "cache/infection/infection.log",
        "summary": "cache/infection/summary.log"
    },
    // The measured value of the full run is 100% (57 mutants; one mutant is 1.75 points).
    // The margin permits one escaped mutant. Raise these values only.
    "minMsi": 98,
    "minCoveredMsi": 98,
    "mutators": {
        "@default": true
    }
}
